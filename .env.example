# Copy this file to `.env` and adjust the values. `.env` is git-ignored: never commit it.
# Every setting has a safe default except F1I_DB_PASSWORD.

# --- General ----------------------------------------------------------------
# Environment: dev | test | prod
F1I_ENV=dev
# Log level: DEBUG | INFO | WARNING | ERROR
F1I_LOG_LEVEL=INFO
# Console log format: text | json (the log file is always JSON lines)
F1I_LOG_FORMAT=text

# --- Paths (relative paths are resolved against the project root) ---------
# F1I_DATA_DIR=data
# F1I_FASTF1_CACHE_DIR=data/cache/fastf1
# F1I_LOG_DIR=logs

# --- PostgreSQL (read by docker-compose.yml and by the application) --------
F1I_DB_HOST=localhost
F1I_DB_PORT=5432
F1I_DB_NAME=f1i
F1I_DB_USER=f1i
F1I_DB_PASSWORD=change-me

# --- Jolpica-F1 API ----------------------------------------------------------
# Public limits for unauthenticated clients: 4 req/s burst, 500 req/h sustained.
# We stay below them on purpose.
F1I_JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
F1I_JOLPICA_MAX_REQUESTS_PER_SECOND=3
F1I_JOLPICA_MAX_REQUESTS_PER_HOUR=450
